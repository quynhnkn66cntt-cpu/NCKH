@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.semanticweb.org/pc/ontologies/2026/6/shrimp-traceability#> .

:TraceabilityEventShape
    a sh:NodeShape ;
    sh:targetClass :TraceabilityEvent ;

    sh:property [
        sh:path :eventID ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TraceabilityEvent must have exactly one eventID." ;
    ] ;

    sh:property [
        sh:path :timestamp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "TraceabilityEvent must have exactly one timestamp." ;
    ] ;

    sh:property [
        sh:path :performedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :Actor ;
        sh:message "TraceabilityEvent must have exactly one actor." ;
    ] ;

    sh:property [
        sh:path :batchID ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TraceabilityEvent must have exactly one batchID." ;
    ] ;

    sh:property [
        sh:path :dataHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TraceabilityEvent must have exactly one dataHash." ;
    ] ;

    sh:property [
        sh:path :currentHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TraceabilityEvent must have exactly one currentHash." ;
    ] ;

    sh:property [
        sh:path :txHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TraceabilityEvent must have exactly one blockchain transaction ID (txHash)." ;
    ] ;

    sh:property [
        sh:path :blockNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:long ;
        sh:message "TraceabilityEvent must have exactly one blockchain blockNumber." ;
    ] .


:PreviousHashShape
    a sh:NodeShape ;
    sh:targetClass :TraceabilityEvent ;

    sh:property [
        sh:path :previousEventHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every TraceabilityEvent must have exactly one previousEventHash; genesis uses GENESIS." ;
    ] .

:ProcessingLotShape
    a sh:NodeShape ;
    sh:targetClass :LoCheBien ;

    sh:property [
        sh:path :processedFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :LoThuHoach ;
        sh:message "ProcessingLot must link to exactly one HarvestLot." ;
    ] .


:ShipmentShape
    a sh:NodeShape ;
    sh:targetClass :Shipment ;

    sh:property [
        sh:path :handleBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :Transporter ;
        sh:message "Shipment must have exactly one Transporter." ;
    ] .
:GenesisEventShape
    a sh:NodeShape ;
    sh:targetNode :TraceabilityEvent_EV001 ;

    sh:property [
        sh:path :previousEventHash ;
        sh:hasValue "GENESIS"^^xsd:string ;
        sh:message "Genesis event EV001 must have previousEventHash equal to GENESIS." ;
    ] .
:NonGenesisHashShape
    a sh:NodeShape ;
    sh:targetClass :TraceabilityEvent ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Only EV001 may use GENESIS as previousEventHash." ;
        sh:select """
            SELECT $this
            WHERE {
                $this :previousEventHash "GENESIS"^^xsd:string .
                FILTER ($this != :TraceabilityEvent_EV001)
            }
        """ ;
    ] .